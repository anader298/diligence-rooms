    {"id": "socials.linkedin", "label": "LinkedIn", "page": "socials", "group": "Accounts", "kind": "fact", "vars": ["social.accounts"], "match": "linkedin\\.com"},
    {"id": "socials.x", "label": "X", "page": "socials", "group": "Accounts", "kind": "fact", "vars": ["social.accounts"], "match": "(^|[/.])(x|twitter)\\.com"},
    {"id": "socials.instagram", "label": "Instagram", "page": "socials", "group": "Accounts", "kind": "fact", "vars": ["social.accounts"], "match": "instagram\\.com"},
    {"id": "socials.facebook", "label": "Facebook", "page": "socials", "group": "Accounts", "kind": "fact", "vars": ["social.accounts"], "match": "facebook\\.com"},
