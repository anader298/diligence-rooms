    {"id": "names.aliases", "label": "Other names and spellings", "page": "names", "group": "Names", "kind": "list", "vars": ["names.aliases"], "hint": "Maiden and married names, nicknames, transliterations, initials forms", "required": true},
    {"id": "names.handles", "label": "Handle pattern", "page": "names", "group": "Names", "kind": "fact", "vars": ["social.handles"]},
