# Copy to .env for local runs. In production set these as site environment
# variables (Site configuration > Environment variables), never in the repo.

# Signs every room's session cookie. Long and random, e.g.:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Changing it signs everyone out of every room.
ROOM_COOKIE_SECRET=replace-with-a-long-random-string

# One per room. Slug upper-cased, dashes become underscores.
# A room with no password set returns 404.
ROOM_PASSWORD_NORTHWIND=replace-with-the-room-password

# Research runs (npm run studio > Connect AI). Leave these unset to use the Claude Code or
# Codex you are signed in to; the studio writes them here if you paste a key instead.
# ANTHROPIC_API_KEY=sk-ant-...   (Claude Code)
# OPENAI_API_KEY=sk-...          (Codex)

# The companion (live helper, optional). On Netlify, AI Gateway supplies the keys
# automatically; set them yourself only when running elsewhere.
# ANTHROPIC_API_KEY=your-key
# GEMINI_API_KEY=your-key
#
# Fast lane: transcript cleanup, speaker guess, question detection, quick cards.
ASSIST_FAST_MODEL=claude-opus-5-5
# Deep lane: the considered answer, streamed, with the whole room as a cached prompt.
ASSIST_DEEP_MODEL=claude-fable-5-2
# Optional tuning: effort per lane (low | medium | high | xhigh | max).
# ASSIST_FAST_EFFORT=low
# ASSIST_DEEP_EFFORT=medium
# Server-side refusal fallbacks are on ("default" routing); "off" drops them.
# ASSIST_REFUSAL_FALLBACK=default
# Extra model ids tried last if a lane's model is not available.
# ASSIST_MODELS=claude-opus-5
# Speech-to-text model for the 8-second audio chunks.
# ASSIST_STT_MODEL=gemini-2.5-flash

# Data connectors (npm run enrich, stage 2b). Bring your own accounts; leave unset what you do
# not use. The studio shows only whether each key is set, never its value. Every run prints a
# credit estimate and stops until you confirm (--yes). Providers to try: config/connectors.json.
# APOLLO_API_KEY=your-key                 # or use the Apollo MCP server in Claude Code (apollo-mcp)
# ZOOMINFO_USERNAME=your-username         # with ZOOMINFO_PASSWORD; or ZOOMINFO_ACCESS_TOKEN
# ZOOMINFO_PASSWORD=your-password
# ZOOMINFO_ACCESS_TOKEN=
# LUSHA_API_KEY=your-key
# COGNISM_API_KEY=your-key
# CLAY_WEBHOOK_URL=the-webhook-url-of-your-clay-table
# CLAY_WEBHOOK_TOKEN=
# CRUNCHBASE_API_KEY=your-key
# PITCHBOOK_API_KEY=your-key
